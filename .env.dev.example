APP_ENV=development
APP_VERSION=0.6.0-dev
REQUIRE_STRONG_SECRETS=false
PORT=8010
DB_FILE=./logs.db
LOG_FILE=/var/log/docker-app/nginx-proxy-manager/access-geo-detailed.log
ALLOWED_ORIGINS=http://localhost:8010,http://localhost:8000
SESSION_COOKIE_SECURE=false
ADMIN_TOKEN=dev-token-change-me
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret
EXPORT_DIR=./data/exports
BACKUP_DIR=./data/backups
AUTO_BAN_DRY_RUN=true
